# Core platform API (engsoc-platform). Copy to .env.local for local development.
# Never commit .env.local. Every variable here is SERVER-ONLY: none may be renamed NEXT_PUBLIC_*.
# Details: integration/INTEGRATION_ARCHITECTURE.md and integration/DEPLOYMENT_GUIDE.md.

# The Core API's address, including the version path.
#   Production:  https://api.essqu.com/v1
#   Staging:     the staging Core's /v1 address (never production, for Preview deployments)
#   Local:       http://127.0.0.1:3001/v1   (plain http is accepted only for this machine)
# Leave empty in local development to use the site's sample events instead.
CORE_API_BASE_URL=

# Bearer token with the events:read scope, issued by Core (essq_live_… or essq_test_…).
# Server-only. Required whenever CORE_API_BASE_URL is set.
CORE_EVENTS_API_KEY=

# Optional. "sample" shows the site's sample events (labelled "Sample") instead of Core, for
# design review or a Preview without a staging Core. Refused on Vercel production.
CORE_API_MODE=

# Optional tuning. Read timeout in ms (default 4000, 500–15000) and how long event reads are
# cached on the server in seconds (default 30, 0–300; Core's guidance is at most 30).
CORE_API_TIMEOUT_MS=
CORE_EVENTS_REVALIDATE_SECONDS=

# Optional. "true" logs every Core request (route, status, latency, request id), not only failures.
CORE_API_DEBUG=
